	(text_box "MCU"
		(exclude_from_sim no)
		(at 68.58 43.18 0)
		(size 6.35 3.81)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "531ac8e9-b420-452e-bbe0-a928345328ce")
	)
	(text_box "MCU receives the LED Circuit's op-amps' voltage differential and determines whether or not there is too much current flowing through the LEDs. If that's the case, the MCU controls the NFET to reduce current flow to an appropriate amount."
		(exclude_from_sim no)
		(at 109.22 82.55 0)
		(size 29.21 15.24)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "5726ec09-fbbf-44ea-8a1e-e125c6d46a7e")
	)
	(text_box "The Constant Current Driver is an essential part of the Heliosphere, which tests the voltage and current of solar cells. It regulates the current flowing through the grow LEDs to ensure that the LEDs don't burn out since this is a high power application. Grow LEDs were chosen because they improve the spectral match of the LEDs to the sun's electromagnetic spectrum (Spectral match affects the way solar cells behave). There are multiple LEDs to ensure that the light intensity is sufficient enough to mimick the sun. "
		(exclude_from_sim no)
		(at 19.05 163.83 0)
		(size 68.58 26.67)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "59b72c0a-575e-45d5-a222-a6ab9638b167")
	)
	(text_box "Power Supplies\n"
		(exclude_from_sim no)
		(at 229.87 43.18 0)
		(size 17.78 3.81)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
