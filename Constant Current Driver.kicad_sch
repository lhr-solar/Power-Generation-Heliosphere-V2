			)
			(justify left top)
		)
		(uuid "71739b16-82f5-40cc-93ec-5a37e88007a7")
	)
	(text_box "VVD1 and VDD2 use LCS-C-100 Power Supplies. VDD3 uses IKOKKO 100 V Power Supply. +3V3 is coming from the computer."
		(exclude_from_sim no)
		(at 224.79 62.23 0)
