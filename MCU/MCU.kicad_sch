	(text "MAX31865 CS  →  MCU SSEL (or GPIO used as CS)- D3 SPI1(PA4 SPI3_SSEL)\nMAX31865 SCLK → MCU SCLK - PA5 SPI1(D13 SPI3_SCLK)\nMAX31865 SDI  → MCU MOSI - PA7 SPI1(D11 SPI3_MOSI)\nMAX31865 SDO  → MCU MISO - PA6 SPI1(D12 SPI3_MISO)\nMAX31865 DRDY → digital input pin (HIGH when MAX is busy\n			performing conversion. LOW when new\n			measurement is ready)- D7\n\nNot enough pins on the Current Regulating MCU. Will use another one."
		(exclude_from_sim no)
		(at 132.08 165.608 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "052eda9e-2d3e-4fa4-803d-9173fd09b610")
	)
	(text "Goes into RTD\n"
		(exclude_from_sim no)
		(at 184.15 132.588 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "38c6a5af-0f11-4ef1-8d1e-6da2795c00a7")
	)
	(text "CONNECTORS:\n3 2-port connectors between LED CONTROLS and LEDs (PWR, GND)\n\nGND --- STM32 GND\nGND1 --- LED GND"
		(exclude_from_sim no)
		(at 188.976 24.638 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5ce68eed-c924-4bc9-905f-b0c50aa363a3")
	)
	(text "Power supplies are connected in parallel --> 100 V 3 A in total"
		(exclude_from_sim no)
		(at 249.174 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6512e671-9032-40ab-9d4a-c77ffdee5915")
	)
	(text "Connector to Power Supply Chains\n"
		(exclude_from_sim no)
		(at 263.144 80.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "994baeb8-e3ba-42d8-a593-0beadd9f29a9")
	)
	(text "Connectors J1-3 connect power to the LED modules\nand route them back to the LED CONTROLS modules.\nThis sets the NFET up as a low-side switch."
		(exclude_from_sim no)
		(at 209.55 58.166 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bf4e032f-6e77-4350-9238-a2a7aec15ca1")
	)
	(text_box "MCU receives the LED Circuit's op-amps' voltage differential and determines whether or not there is too much current flowing through the LEDs. If that's the case, the MCU controls the NFET to reduce current flow to an appropriate amount."
		(exclude_from_sim no)
		(at 234.95 13.97 0)
		(size 39.37 19.05)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fd00c088-1f10-4337-9cc3-70562ff17e09")
	)
