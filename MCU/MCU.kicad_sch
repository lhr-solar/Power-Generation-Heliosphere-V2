		(at 263.144 80.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "994baeb8-e3ba-42d8-a593-0beadd9f29a9")
	)
	(text "Connectors J1-3 connect power to the LED modules\nand route them back to the LED CONTROLS modules.\nThis sets the NFET up as a low-side switch."
		(exclude_from_sim no)
		(at 209.55 58.166 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bf4e032f-6e77-4350-9238-a2a7aec15ca1")
	)
	(text "Use separate power supply to power the isolated amplifiers\nand the temperature sensor."
		(exclude_from_sim no)
		(at 68.58 134.112 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d0c12939-ae32-426e-82e7-164fe72a0435")
	)
	(text_box "PA0,  --> takes in op amp voltage diff\nPA1 --> outputs signal from nucleo"
		(exclude_from_sim no)
		(at 234.95 38.1 0)
		(size 46.99 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4f830a78-db3f-4929-ae49-6e0c2de32022")
	)
	(text_box "MCU receives the LED Circuit's op-amps' voltage differential and determines whether or not there is too much current flowing through the LEDs. If that's the case, the MCU controls the NFET to reduce current flow to an appropriate amount."
		(exclude_from_sim no)
		(at 234.95 13.97 0)
		(size 39.37 19.05)
		(margins 0.9525 0.9525 0.9525 0.9525)
