	)
	(text "MAX31865 CS  →  MCU SSEL (or GPIO used as CS)- PA4 SPI3_SSEL\nMAX31865 SCLK → MCU SCLK - D13 SPI3_SCLK\nMAX31865 SDI  → MCU MOSI - D11 SPI3_MOSI\nMAX31865 SDO  → MCU MISO - D12 SPI3_MISO\nMAX31865 DRDY → digital input pin (HIGH when MAX is busy\n			performing conversion. LOW when new\n			measurement is ready)- D7\n\nNot enough pins on the Current Regulating MCU. Will use another one."
		(exclude_from_sim no)
		(at 60.452 35.814 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d6e33587-b76c-412d-bc41-f883b7f123ea")
	)
